# 服务器部署配置：复制本文件为 .env 并填入真实值（docker-compose 会自动读取）
# 注意：这是 product/video-note/ 目录下、给 docker-compose 用的 .env

# DeepSeek 摘要模型 key（deepseek-v4-flash）
OPENAI_API_KEY=sk-你的deepseek-key

# 阿里云百炼 语音识别 key 和工作空间端点
DASHSCOPE_API_KEY=sk-ws-你的key
DASHSCOPE_BASE_URL=https://ws-你的工作空间id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1

# 内测邀请码（手机号+邀请码登录，公网访问必须设置，防止别人滥用）
INVITE_CODE=换成你的内测邀请码

# PostgreSQL 密码（db 服务用，默认 video_note，建议改掉）
POSTGRES_PASSWORD=video_note
